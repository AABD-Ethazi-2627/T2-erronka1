{
  "description": "CG18 prediction shape/current-state guard; preserves canonical _source. API owns full JSON Schema validation; strict mapping owns storage types.",
  "version": 1,
  "_meta": {
    "pipeline_id": "cnc-prediction-v1",
    "contract_sha256": {
      "common.schema.json": "149f53de0e5c210a26d2aa75a23c8eeac3cf94fc0f024fbe7a2258b1ffc3d9e2",
      "prediction.schema.json": "bcf7fc02aa50e50538bf97f16226435a37eb213be067949c6c0a57351fbecb32"
    },
    "mutates_source": false
  },
  "processors": [
    {
      "script": {
        "tag": "prediction-contract-guard-v1",
        "lang": "painless",
        "source": "for (def section : params.sections) {\n  def obj = section.path == '' ? ctx : ctx[section.path];\n  if (!(obj instanceof Map)) {\n    throw new IllegalArgumentException('CG18 object required: ' + section.path);\n  }\n  for (def name : section.required) {\n    if (!obj.containsKey(name) || obj[name] == null) {\n      throw new IllegalArgumentException('CG18 required: ' + name);\n    }\n  }\n  for (def name : obj.keySet()) {\n    if (!section.rules.containsKey(name)) {\n      if (section.path == '' && params.metadata.contains(name)) { continue; }\n      throw new IllegalArgumentException('CG18 unknown field: ' + name);\n    }\n    def rule = section.rules[name];\n    def value = obj[name];\n    boolean valid = rule.type == 'object' ? value instanceof Map :\n      rule.type == 'string' ? value instanceof String :\n      rule.type == 'boolean' ? value instanceof Boolean : value instanceof Number;\n    if (!valid) { throw new IllegalArgumentException('CG18 type: ' + name); }\n    if (rule.containsKey('const') && !rule['const'].equals(value)) {\n      throw new IllegalArgumentException('CG18 const: ' + name);\n    }\n    if (rule.containsKey('enum') && !rule['enum'].contains(value)) {\n      throw new IllegalArgumentException('CG18 enum: ' + name);\n    }\n    if (rule.containsKey('minLength') && value.length() < rule.minLength) {\n      throw new IllegalArgumentException('CG18 empty string: ' + name);\n    }\n    if (rule.type == 'number') {\n      double n = value.doubleValue();\n      if (!Double.isFinite(n) ||\n          (rule.containsKey('minimum') && n < rule.minimum) ||\n          (rule.containsKey('maximum') && n > rule.maximum) ||\n          (rule.containsKey('exclusiveMinimum') && n <= rule.exclusiveMinimum)) {\n        throw new IllegalArgumentException('CG18 range: ' + name);\n      }\n    }\n  }\n}\n",
        "params": {
          "metadata": [
            "_index",
            "_id",
            "_routing",
            "_version",
            "_version_type",
            "_dynamic_templates",
            "_ingest"
          ],
          "sections": [
            {
              "path": "",
              "required": [
                "event_id",
                "machine_id",
                "timestamp",
                "schema_version",
                "quality_flag",
                "source",
                "scored_at",
                "failure_score",
                "risk_alert",
                "anomaly_score",
                "anomaly_alert",
                "policy",
                "model_version",
                "model_artifact_sha256",
                "risk_threshold",
                "anomaly_threshold",
                "prediction_scope",
                "temporal_prediction_enabled",
                "score_semantics"
              ],
              "rules": {
